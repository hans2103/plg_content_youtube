<?xml version="1.0" encoding="utf-8"?>
<updates>
    <update>
        <name>YouTube video embed for Joomla</name>
        <description>This is a Joomla! plugin which replace `{youtube url}` by the Youtube video. Initially only the YouTube image and a button. After pressing the button both elements are replaced by the YouTube embed iframe and the video starts.</description>
        <element>youtube</element>
        <type>plugin</type>
        <client>site</client>
        <folder>content</folder>
        <version>26.30.0</version>
        <infourl title="YouTube video embed for Joomla">https://github.com/hans2103/plg_content_youtube/releases/tag/26.30.0</infourl>
        <downloads>
            <downloadurl type="full" format="zip">https://github.com/hans2103/plg_content_youtube/releases/download/26.30.0/plg_content_youtube.zip</downloadurl>
        </downloads>
        <sha512>f991a0d33271b06c1efe90dcd338d712fd605c95c40caa93d4af6980f1c968608806b862e8f3f18f881a48d5da3db9cb0f082483b636af9a2023b1882ffad723</sha512>
        <tags>
            <tag>stable</tag>
        </tags>
        <targetplatform name="joomla" version="5.(0|1)" />
        <php_minimum>8.0.0</php_minimum>
    </update>
</updates>
